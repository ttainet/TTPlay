{
  "app-id": "com.ttai.ttplay",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "ttplay",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=all",
    "--own-name=org.mpris.MediaPlayer2.com_ttai_ttplay",
    "--system-talk-name=org.freedesktop.NetworkManager",
    "--filesystem=xdg-run/os_media_controls_artwork:create",
    "--filesystem=xdg-run/discord-ipc-0",
    "--filesystem=xdg-run/discord-ipc-1",
    "--filesystem=xdg-run/discord-ipc-2",
    "--filesystem=xdg-run/discord-ipc-3",
    "--filesystem=xdg-run/discord-ipc-4",
    "--filesystem=xdg-run/discord-ipc-5",
    "--filesystem=xdg-run/discord-ipc-6",
    "--filesystem=xdg-run/discord-ipc-7",
    "--filesystem=xdg-run/discord-ipc-8",
    "--filesystem=xdg-run/discord-ipc-9",
    "--filesystem=xdg-run/app/com.discordapp.Discord:ro",
    "--env=GTK_USE_PORTAL=1"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "ttplay",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a bundle /app/ttplay",
        "install -Dm755 ttplay /app/bin/ttplay",
        "install -Dm644 com.ttai.ttplay.desktop /app/share/applications/com.ttai.ttplay.desktop",
        "install -Dm644 com.ttai.ttplay.metainfo.xml /app/share/metainfo/com.ttai.ttplay.metainfo.xml",
        "install -Dm644 ttplay.png /app/share/icons/hicolor/512x512/apps/com.ttai.ttplay.png",
        "chmod 755 /app/ttplay/ttplay.sh",
        "if test -f /app/ttplay/lib/crashpad_handler; then chmod 755 /app/ttplay/lib/crashpad_handler; fi",
        "python3 relocate-caches.py /app/ttplay"
      ],
      "sources": [
        { "type": "dir", "path": "bundle", "dest": "bundle" },
        { "type": "file", "path": "ttplay" },
        { "type": "file", "path": "relocate-caches.py" },
        { "type": "file", "path": "com.ttai.ttplay.desktop" },
        { "type": "file", "path": "com.ttai.ttplay.metainfo.xml" },
        { "type": "file", "path": "ttplay.png" }
      ]
    }
  ]
}
