 void FlutterWindowsView::ForceRedraw() {
+  // The raster thread holds |resize_mutex_| for the whole frame path
+  // including surface recreation, so a WM_PAINT can briefly block the UI
+  // thread here; that is the price of synchronizing this read.
+  std::unique_lock<std::mutex> lock(resize_mutex_);
   if (resize_status_ == ResizeState::kDone) {
+    lock.unlock();
     // Request new frame.
     engine_->ScheduleFrame();
+    return;
+  }
+
+  // A resize is pending. ForceRedraw is a no-op in this state upstream,
+  // which is exactly why a wedged resize never heals: re-drive it instead
+  // so WM_PAINT and explicit redraw requests can recover the view. Only
+  // re-drive a stale resize, though: WM_PAINT arrives continuously during
+  // an interactive drag-resize and must not burn the retry budget on a
+  // healthy resize.
+  if (resize_status_ == ResizeState::kResizeStarted &&
+      std::chrono::steady_clock::now() >
+          resize_start_time_ + kWindowResizeTimeout) {
+    ScheduleResizeRetryLocked();
   }
 }
 
