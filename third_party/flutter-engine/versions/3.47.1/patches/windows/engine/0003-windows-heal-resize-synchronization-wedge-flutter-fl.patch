+bool FlutterWindowsView::EnsureRenderSurface() {
+  // Called on the raster thread with |resize_mutex_| held.
+  if (surface_ && surface_->IsValid()) {
+    return true;
+  }
+
+  // The surface is missing or was left invalid by a failed resize.
+  // Recreate it so the view can recover instead of dropping every frame
+  // forever.
+  surface_.reset();
+  if (!engine_->egl_manager()) {
+    return false;
+  }
+
+  // Create at the pending resize target when a resize is in flight: the
+  // frame-size check below must compare against the size the platform
+  // thread asked for, not whatever bounds the window happens to have now.
+  // Creating at the target also avoids a follow-up ResizeRenderSurface in
+  // the same call frame, which would destroy the surface that UpdateVsync
+  // may have captured in a posted task.
+  size_t width;
+  size_t height;
+  if (resize_status_ == ResizeState::kResizeStarted) {
+    width = resize_target_width_;
+    height = resize_target_height_;
+  } else {
+    PhysicalWindowBounds bounds = binding_handler_->GetPhysicalWindowBounds();
+    width = bounds.width;
+    height = bounds.height;
+  }
+
+  surface_ = engine_->egl_manager()->CreateWindowSurface(GetWindowHandle(),
+                                                         width, height);
+  if (!surface_) {
+    return false;
+  }
+
+  // Set the swap interval inline, like ResizeRenderSurface does: this runs
+  // on the raster thread already, and posting UpdateVsync would capture a
+  // raw surface pointer that a later resize can free before the task runs.
+  if (!surface_->MakeCurrent() || !surface_->SetVSyncEnabled(NeedsVsync())) {
+    // Surfaces block until the v-blank by default. Failing to update the
+    // vsync might result in unnecessary blocking. This regresses
+    // performance but not correctness.
+    FML_LOG(ERROR) << "Surface recreate failed to set vsync";
+  }
+
+  return surface_->IsValid();
+}
+
+void FlutterWindowsView::ScheduleResizeRetryLocked() {
+  // Callers must hold |resize_mutex_|.
+  std::weak_ptr<std::atomic<bool>> alive = alive_token_;
+  engine_->task_runner()->PostTask([this, alive]() {
+    auto token = alive.lock();
+    if (!token || !token->load()) {
+      return;
+    }
+    DriveResizeRetry();
+  });
+}
+
+void FlutterWindowsView::DriveResizeRetry() {
+  // Called on the platform thread.
+  size_t target_width = 0;
+  size_t target_height = 0;
+  bool force_complete = false;
+  {
+    std::unique_lock<std::mutex> lock(resize_mutex_);
+    if (resize_status_ != ResizeState::kResizeStarted) {
+      return;
+    }
+
+    if (++resize_retries_ > kMaxResizeRetries) {
+      // The framework never produced a frame at the resize target size.
+      // Force-complete the resize on the raster thread: presenting a
+      // wrong-size frame beats a permanently blank window.
+      FML_LOG(ERROR) << "Window resize did not complete after "
+                     << kMaxResizeRetries
+                     << " retries; force-completing the resize.";
+      resize_status_ = ResizeState::kDone;
+      force_complete = true;
+    } else {
+      target_width = resize_target_width_;
+      target_height = resize_target_height_;
+    }
+  }
+
+  if (force_complete) {
+    // Posted outside |resize_mutex_|: the task takes the lock itself.
+    std::weak_ptr<std::atomic<bool>> alive = alive_token_;
+    engine_->PostRasterThreadTask([this, alive]() {
+      auto token = alive.lock();
+      if (!token || !token->load()) {
+        return;
+      }
+      std::unique_lock<std::mutex> lock(resize_mutex_);
+      // Re-check under the lock: the destructor may have run between the
+      // first check and acquiring |resize_mutex_|.
+      if (!token->load()) {
+        return;
+      }
+      ForceCompleteResizeLocked();
+    });
+    return;
+  }
+
+  // Resend the resize target metrics: this is what makes the framework
+  // produce a frame at the target size (handleMetricsChanged forces a
+  // frame once the app has content). ScheduleFrame arms the vsync so the
+  // frame is actually pumped.
+  SendWindowMetrics(target_width, target_height,
+                    binding_handler_->GetDpiScale());
+  engine_->ScheduleFrame();
+}
+
+void FlutterWindowsView::ForceCompleteResizeLocked() {
+  // Called on the raster thread with |resize_mutex_| held.
+  if (!EnsureRenderSurface()) {
+    return;
+  }
+  ResizeRenderSurface(resize_target_width_, resize_target_height_);
+}
+
 egl::WindowSurface* FlutterWindowsView::surface() const {
   return surface_.get();
 }
