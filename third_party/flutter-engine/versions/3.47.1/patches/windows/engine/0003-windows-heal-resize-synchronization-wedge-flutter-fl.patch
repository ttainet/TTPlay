+// If the framework never produces a frame at the resize target size, the
+// resize is force-completed after the retry budget is exhausted so the
+// view cannot wedge permanently.
+TEST(FlutterWindowsViewTest, WindowResizeForceComplete) {
+  auto windows_proc_table = std::make_shared<NiceMock<MockWindowsProcTable>>();
+  std::unique_ptr<FlutterWindowsEngine> engine =
+      GetTestEngine(windows_proc_table);
+
+  EngineModifier engine_modifier{engine.get()};
+  engine_modifier.embedder_api().PostRenderThreadTask = MOCK_ENGINE_PROC(
+      PostRenderThreadTask,
+      ([](auto engine, VoidCallback callback, void* user_data) {
+        callback(user_data);
+        return kSuccess;
+      }));
+
+  auto egl_manager = std::make_unique<egl::MockManager>();
+  auto surface = std::make_unique<egl::MockWindowSurface>();
+  auto resized_surface = std::make_unique<egl::MockWindowSurface>();
+  auto resized_surface_ptr = resized_surface.get();
+
+  EXPECT_CALL(*surface.get(), IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*surface.get(), Destroy).WillOnce(Return(true));
+  EXPECT_CALL(*egl_manager.get(),
+              CreateWindowSurface(_, /*width=*/500, /*height=*/500))
+      .WillOnce(Return(std::move(resized_surface)));
+  EXPECT_CALL(*resized_surface_ptr, IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, MakeCurrent).WillOnce(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, SetVSyncEnabled).WillOnce(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, Destroy).WillOnce(Return(true));
+
+  std::unique_ptr<FlutterWindowsView> view =
+      engine->CreateView(std::make_unique<NiceMock<MockWindowBindingHandler>>(),
+                         /*is_sized_to_content=*/false, BoxConstraints());
+
+  ViewModifier view_modifier{view.get()};
+  engine_modifier.SetEGLManager(std::move(egl_manager));
+  view_modifier.SetSurface(std::move(surface));
+
+  engine_modifier.embedder_api().SendWindowMetricsEvent = MOCK_ENGINE_PROC(
+      SendWindowMetricsEvent,
+      ([](auto engine, const FlutterWindowMetricsEvent* event) {
+        return kSuccess;
+      }));
+  engine_modifier.embedder_api().ScheduleFrame =
+      MOCK_ENGINE_PROC(ScheduleFrame, ([](auto engine) { return kSuccess; }));
+
+  // The resize times out because no frame arrives.
+  EXPECT_FALSE(view->OnWindowSizeChanged(500, 500));
+
+  // Frames at the wrong size are rejected while the resize is pending.
+  EXPECT_FALSE(view->OnFrameGenerated(100, 100));
+
+  // Each rejected frame re-drives the resize. After the retry budget is
+  // exhausted the resize is force-completed on the raster thread.
+  for (int i = 0; i < 70; ++i) {
+    view->OnFrameGenerated(100, 100);
+    engine->task_runner()->ProcessTasks();
+  }
+
+  // The surface was force-resized to the target and the resize is done:
+  // any frame is accepted now.
+  EXPECT_TRUE(view->OnFrameGenerated(100, 100));
+}
+
+// A stale pending resize is re-driven by ForceRedraw (WM_PAINT): the
+// target metrics are resent and a frame is scheduled. This is the heal
+// path for the FancyZones wedge where the framework never produces a
+// frame at the target size.
+TEST(FlutterWindowsViewTest, WindowResizeForceRedrawRedrives) {
+  auto windows_proc_table = std::make_shared<NiceMock<MockWindowsProcTable>>();
+  std::unique_ptr<FlutterWindowsEngine> engine =
+      GetTestEngine(windows_proc_table);
+
+  EngineModifier engine_modifier{engine.get()};
+  engine_modifier.embedder_api().PostRenderThreadTask = MOCK_ENGINE_PROC(
+      PostRenderThreadTask,
+      ([](auto engine, VoidCallback callback, void* user_data) {
+        callback(user_data);
+        return kSuccess;
+      }));
+
+  auto egl_manager = std::make_unique<egl::MockManager>();
+  auto surface = std::make_unique<egl::MockWindowSurface>();
+  auto resized_surface = std::make_unique<egl::MockWindowSurface>();
+  auto resized_surface_ptr = resized_surface.get();
+
+  EXPECT_CALL(*surface.get(), IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*surface.get(), Destroy).WillOnce(Return(true));
+  EXPECT_CALL(*egl_manager.get(),
+              CreateWindowSurface(_, /*width=*/500, /*height=*/500))
+      .WillOnce(Return(std::move(resized_surface)));
+  EXPECT_CALL(*resized_surface_ptr, IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, MakeCurrent).WillOnce(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, SetVSyncEnabled).WillOnce(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, Destroy).WillOnce(Return(true));
+  EXPECT_CALL(*windows_proc_table.get(), DwmFlush).WillOnce(Return(S_OK));
+
+  std::unique_ptr<FlutterWindowsView> view =
+      engine->CreateView(std::make_unique<NiceMock<MockWindowBindingHandler>>(),
+                         /*is_sized_to_content=*/false, BoxConstraints());
+
+  ViewModifier view_modifier{view.get()};
+  engine_modifier.SetEGLManager(std::move(egl_manager));
+  view_modifier.SetSurface(std::move(surface));
+
+  int metrics_sent = 0;
+  engine_modifier.embedder_api().SendWindowMetricsEvent = MOCK_ENGINE_PROC(
+      SendWindowMetricsEvent,
+      ([&metrics_sent](auto engine, const FlutterWindowMetricsEvent* event) {
+        ++metrics_sent;
+        return kSuccess;
+      }));
+  int schedule_frame_calls = 0;
+  engine_modifier.embedder_api().ScheduleFrame =
+      MOCK_ENGINE_PROC(ScheduleFrame, ([&schedule_frame_calls](auto engine) {
+                         ++schedule_frame_calls;
+                         return kSuccess;
+                       }));
+
+  // The resize times out because no frame arrives, leaving a stale
+  // pending resize.
+  EXPECT_FALSE(view->OnWindowSizeChanged(500, 500));
+  int metrics_after_resize = metrics_sent;
+  int frames_after_resize = schedule_frame_calls;
+
+  // WM_PAINT on the stale resize re-drives it.
+  view->ForceRedraw();
+  engine->task_runner()->ProcessTasks();
+  EXPECT_GT(metrics_sent, metrics_after_resize);
+  EXPECT_GT(schedule_frame_calls, frames_after_resize);
+
+  // The framework produces a frame at the target size, which completes
+  // the resize.
+  EXPECT_TRUE(view->OnFrameGenerated(500, 500));
+  view->OnFramePresented();
+}
