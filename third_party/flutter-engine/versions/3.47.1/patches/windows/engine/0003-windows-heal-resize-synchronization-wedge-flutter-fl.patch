+  // path stops re-driving once the resize is done.
+  for (int i = 0; i < 70; ++i) {
+    view->OnFrameGenerated(500, 500);
+    engine->task_runner()->ProcessTasks();
+  }
+  int metrics_after_budget = metrics_sent;
+  view->OnFrameGenerated(500, 500);
+  engine->task_runner()->ProcessTasks();
+  EXPECT_EQ(metrics_sent, metrics_after_budget);
