+// When a resize is pending and the surface is missing, resurrection
+// creates the surface at the resize target - not the window's current
+// bounds - so the frame-size contract still holds.
+TEST(FlutterWindowsViewTest, WindowResizeResurrectsAtResizeTarget) {
+  auto windows_proc_table = std::make_shared<NiceMock<MockWindowsProcTable>>();
+  std::unique_ptr<FlutterWindowsEngine> engine =
+      GetTestEngine(windows_proc_table);
+
+  EngineModifier engine_modifier{engine.get()};
+  engine_modifier.embedder_api().PostRenderThreadTask = MOCK_ENGINE_PROC(
+      PostRenderThreadTask,
+      ([](auto engine, VoidCallback callback, void* user_data) {
+        callback(user_data);
+        return kSuccess;
+      }));
+
+  auto egl_manager = std::make_unique<egl::MockManager>();
+  auto surface = std::make_unique<egl::MockWindowSurface>();
+  auto resurrected_surface = std::make_unique<egl::MockWindowSurface>();
+  auto resurrected_surface_ptr = resurrected_surface.get();
+  auto resized_surface = std::make_unique<egl::MockWindowSurface>();
+  auto resized_surface_ptr = resized_surface.get();
+
+  EXPECT_CALL(*surface.get(), IsValid).WillRepeatedly(Return(false));
+
+  // The surface is resurrected at the pending resize target (500x500),
+  // not the window's current bounds (100x100). Mock surfaces report 0x0,
+  // so the matching frame then resizes once more to the same target.
+  EXPECT_CALL(*egl_manager.get(),
+              CreateWindowSurface(_, /*width=*/500, /*height=*/500))
+      .WillOnce(Return(std::move(resurrected_surface)))
+      .WillOnce(Return(std::move(resized_surface)));
+  EXPECT_CALL(*resurrected_surface_ptr, IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*resurrected_surface_ptr, MakeCurrent).WillOnce(Return(true));
+  EXPECT_CALL(*resurrected_surface_ptr, SetVSyncEnabled).WillOnce(Return(true));
+  EXPECT_CALL(*resurrected_surface_ptr, Destroy).WillOnce(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, MakeCurrent).WillOnce(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, SetVSyncEnabled).WillOnce(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, Destroy).WillOnce(Return(true));
+  EXPECT_CALL(*windows_proc_table.get(), DwmIsCompositionEnabled)
+      .WillRepeatedly(Return(FALSE));
+  EXPECT_CALL(*windows_proc_table.get(), DwmFlush).WillOnce(Return(S_OK));
+
+  auto window = std::make_unique<NiceMock<MockWindowBindingHandler>>();
+  EXPECT_CALL(*window.get(), GetPhysicalWindowBounds)
+      .WillRepeatedly(Return(PhysicalWindowBounds{100, 100}));
+
+  std::unique_ptr<FlutterWindowsView> view =
+      engine->CreateView(std::move(window),
+                         /*is_sized_to_content=*/false, BoxConstraints());
+
+  ViewModifier view_modifier{view.get()};
+  engine_modifier.SetEGLManager(std::move(egl_manager));
+  view_modifier.SetSurface(std::move(surface));
+
+  engine_modifier.embedder_api().SendWindowMetricsEvent = MOCK_ENGINE_PROC(
+      SendWindowMetricsEvent,
+      ([](auto engine, const FlutterWindowMetricsEvent* event) {
+        return kSuccess;
+      }));
+  engine_modifier.embedder_api().ScheduleFrame =
+      MOCK_ENGINE_PROC(ScheduleFrame, ([](auto engine) { return kSuccess; }));
+
+  // A resize to 500x500 starts while the surface is missing. The platform
+  // thread does not block: there is nothing to synchronize against.
+  EXPECT_TRUE(view->OnWindowSizeChanged(500, 500));
+
+  // A frame at the wrong size is still rejected: the resize target was
+  // not clobbered by the window's current bounds.
+  EXPECT_FALSE(view->OnFrameGenerated(100, 100));
+
+  // A frame at the target size resurrects the surface at 500x500 and
+  // completes the resize.
+  EXPECT_TRUE(view->OnFrameGenerated(500, 500));
+  view->OnFramePresented();
+}
