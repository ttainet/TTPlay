 }
 
+// The window comes back to the surface's size while a resize to another
+// size is still waiting for its frame: PowerToys FancyZones restores a
+// window that was just maximized, and window_manager's ForceChildRefresh
+// grows the view by a pixel and shrinks it back. The pending resize must
+// follow the window, or every frame at the window's real size is dropped
+// and its retries send metrics outside their own constraints, which the
+// embedder rejects - a permanently blank window
+// (flutter/flutter#159630).
+TEST(FlutterWindowsViewTest, WindowResizeFollowsWindowBackToSurfaceSize) {
+  auto windows_proc_table = std::make_shared<NiceMock<MockWindowsProcTable>>();
+  std::unique_ptr<FlutterWindowsEngine> engine =
+      GetTestEngine(windows_proc_table);
+
+  EngineModifier engine_modifier{engine.get()};
+  engine_modifier.embedder_api().PostRenderThreadTask = MOCK_ENGINE_PROC(
+      PostRenderThreadTask,
+      ([](auto engine, VoidCallback callback, void* user_data) {
+        callback(user_data);
+        return kSuccess;
+      }));
+
+  auto egl_manager = std::make_unique<egl::MockManager>();
+  auto surface = std::make_unique<SizedMockWindowSurface>(100, 100);
+  auto surface_ptr = surface.get();
+
+  // The surface already has the window's final size: nothing recreates it.
+  EXPECT_CALL(*surface_ptr, IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*surface_ptr, Destroy).WillOnce(Return(true));
+  EXPECT_CALL(*egl_manager.get(), CreateWindowSurface).Times(0);
+  EXPECT_CALL(*windows_proc_table.get(), DwmFlush).WillOnce(Return(S_OK));
+
+  PhysicalWindowBounds bounds{100, 100};
+  auto window = std::make_unique<NiceMock<MockWindowBindingHandler>>();
+  ON_CALL(*window.get(), GetPhysicalWindowBounds)
+      .WillByDefault([&bounds]() { return bounds; });
+
+  std::unique_ptr<FlutterWindowsView> view =
+      engine->CreateView(std::move(window),
+                         /*is_sized_to_content=*/false, BoxConstraints());
+
+  ViewModifier view_modifier{view.get()};
+  engine_modifier.SetEGLManager(std::move(egl_manager));
+  view_modifier.SetSurface(std::move(surface));
+
+  std::vector<FlutterWindowMetricsEvent> metrics;
+  engine_modifier.embedder_api().SendWindowMetricsEvent = MOCK_ENGINE_PROC(
+      SendWindowMetricsEvent,
+      ([&metrics](auto engine, const FlutterWindowMetricsEvent* event) {
+        metrics.push_back(*event);
+        return kSuccess;
+      }));
+  engine_modifier.embedder_api().ScheduleFrame =
+      MOCK_ENGINE_PROC(ScheduleFrame, ([](auto engine) { return kSuccess; }));
+
+  // The window grows by a pixel, and the frame at that size does not
+  // arrive before the resize times out.
+  bounds = {101, 100};
+  EXPECT_FALSE(view->OnWindowSizeChanged(101, 100));
+
+  // The window shrinks back to the surface's size.
+  bounds = {100, 100};
+  EXPECT_TRUE(view->OnWindowSizeChanged(100, 100));
+
+  // The retry queued by the timeout drives the window's size: every
+  // metrics event is one the embedder accepts.
+  engine->task_runner()->ProcessTasks();
+  ASSERT_FALSE(metrics.empty());
+  for (const FlutterWindowMetricsEvent& event : metrics) {
+    EXPECT_GE(event.width, event.min_width_constraint);
+    EXPECT_LE(event.width, event.max_width_constraint);
+    EXPECT_GE(event.height, event.min_height_constraint);
+    EXPECT_LE(event.height, event.max_height_constraint);
+  }
+  EXPECT_EQ(metrics.back().width, 100);
+  EXPECT_EQ(metrics.back().height, 100);
+
+  // A frame at the window's size completes the resize, and frames keep
+  // being presented afterwards.
+  EXPECT_TRUE(view->OnFrameGenerated(100, 100));
+  view->OnFramePresented();
+  EXPECT_TRUE(view->OnFrameGenerated(100, 100));
+}
+
