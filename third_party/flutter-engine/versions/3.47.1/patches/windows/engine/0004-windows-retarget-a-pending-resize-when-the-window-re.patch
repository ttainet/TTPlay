+// A mock surface with a real size: |MockWindowSurface| reports 0x0, so every
+// resize against it looks like a resize to a new size.
+class SizedMockWindowSurface : public egl::MockWindowSurface {
+ public:
+  SizedMockWindowSurface(size_t width, size_t height)
+      : width_(width), height_(height) {}
+
+  size_t width() const override { return width_; }
+  size_t height() const override { return height_; }
+
+ private:
+  size_t width_;
+  size_t height_;
+};
