From ea838715ec764ee8aac61f5c4adfabfbb73d9043 Mon Sep 17 00:00:00 2001
From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Sat, 31 Oct 2026 16:44:04 +0100
Subject: [PATCH 4/4] windows: retarget a pending resize when the window
 returns to the surface size

A resize that is still waiting for its frame kept its target when the
window came back to the size the surface already had: SurfaceWillUpdate is
false for that size, so OnWindowSizeChanged only sent its metrics. PowerToys
FancyZones does this when it restores a window that was just maximized into
its zone, and window_manager's ForceChildRefresh does it when it grows the
view by a pixel and shrinks it back. Every frame the framework then rendered
at the window's real size was dropped as not matching the stale target, and
DriveResizeRetry resent the stale size with constraints taken from the
current bounds, which the embedder rejects (kInvalidArguments). The window
stayed white until it was resized by hand (flutter/flutter#159630,
edde746/plezy#2879).

- Retarget a pending resize to every non-zero window size, including the
  surface's own; a frame at that size completes it without a new surface.
- Drive retries from the window's current bounds so their metrics always
  satisfy their own constraints; skip them while minimized.
- Schedule a frame after force-completing a resize so the view is drawn
  without waiting for input.

diff --git a/engine/src/flutter/shell/platform/windows/flutter_windows_view.cc b/engine/src/flutter/shell/platform/windows/flutter_windows_view.cc
index 64172dbf..8c46dada 100644
--- a/engine/src/flutter/shell/platform/windows/flutter_windows_view.cc
+++ b/engine/src/flutter/shell/platform/windows/flutter_windows_view.cc
@@ -300,6 +300,22 @@ bool FlutterWindowsView::OnWindowSizeChanged(size_t width, size_t height) {
       resize_target_height_ = height;
       resize_retries_ = 0;
       resize_start_time_ = std::chrono::steady_clock::now();
+    } else if (resize_status_ == ResizeState::kResizeStarted && width > 0 &&
+               height > 0) {
+      // The window came back to the size the surface already has while a
+      // resize to another size was still waiting for its frame: a window
+      // manager maximizes and then restores the window (PowerToys
+      // FancyZones), or window_manager's ForceChildRefresh grows the view by
+      // a pixel and shrinks it back. Retarget the pending resize to the
+      // window's size. Keeping the old target would drop every frame the
+      // framework renders at the window's real size, and the retries would
+      // resend metrics the window no longer has, leaving the view blank
+      // (flutter/flutter#159630). A frame at this size completes the resize
+      // without recreating the surface.
+      resize_target_width_ = width;
+      resize_target_height_ = height;
+      resize_retries_ = 0;
+      resize_start_time_ = std::chrono::steady_clock::now();
     }
   }
 
@@ -1032,8 +1048,12 @@ void FlutterWindowsView::ScheduleResizeRetryLocked() {
 
 void FlutterWindowsView::DriveResizeRetry() {
   // Called on the platform thread.
-  size_t target_width = 0;
-  size_t target_height = 0;
+  //
+  // A retry drives the window's current size, not a remembered target:
+  // SendWindowMetrics takes its constraints from the current bounds, so
+  // metrics for any other size are rejected by the embedder
+  // (kInvalidArguments) and no frame at that size can ever arrive.
+  PhysicalWindowBounds bounds = binding_handler_->GetPhysicalWindowBounds();
   bool force_complete = false;
   {
     std::unique_lock<std::mutex> lock(resize_mutex_);
@@ -1041,8 +1061,16 @@ void FlutterWindowsView::DriveResizeRetry() {
       return;
     }
 
+    if (bounds.width == 0 || bounds.height == 0) {
+      // Minimized: nothing renders until the next WM_SIZE retargets the
+      // resize, so there is nothing to drive and no budget to spend.
+      return;
+    }
+    resize_target_width_ = bounds.width;
+    resize_target_height_ = bounds.height;
+
     if (++resize_retries_ > kMaxResizeRetries) {
-      // The framework never produced a frame at the resize target size.
+      // The framework never produced a frame at the window's size.
       // Force-complete the resize on the raster thread: presenting a
       // wrong-size frame beats a permanently blank window.
       FML_LOG(ERROR) << "Window resize did not complete after "
@@ -1050,9 +1078,6 @@ void FlutterWindowsView::DriveResizeRetry() {
                      << " retries; force-completing the resize.";
       resize_status_ = ResizeState::kDone;
       force_complete = true;
-    } else {
-      target_width = resize_target_width_;
-      target_height = resize_target_height_;
     }
   }
 
@@ -1072,14 +1097,17 @@ void FlutterWindowsView::DriveResizeRetry() {
       }
       ForceCompleteResizeLocked();
     });
+    // The frames before the force-complete were all dropped. Ask for one
+    // now so the view is drawn without waiting for unrelated input.
+    engine_->ScheduleFrame();
     return;
   }
 
-  // Resend the resize target metrics: this is what makes the framework
-  // produce a frame at the target size (handleMetricsChanged forces a
-  // frame once the app has content). ScheduleFrame arms the vsync so the
-  // frame is actually pumped.
-  SendWindowMetrics(target_width, target_height,
+  // Resend the window's metrics: this is what makes the framework produce a
+  // frame at that size (handleMetricsChanged forces a frame once the app
+  // has content). ScheduleFrame arms the vsync so the frame is actually
+  // pumped.
+  SendWindowMetrics(bounds.width, bounds.height,
                     binding_handler_->GetDpiScale());
   engine_->ScheduleFrame();
 }
diff --git a/engine/src/flutter/shell/platform/windows/flutter_windows_view.h b/engine/src/flutter/shell/platform/windows/flutter_windows_view.h
index 1ecd9069..9563bdaf 100644
--- a/engine/src/flutter/shell/platform/windows/flutter_windows_view.h
+++ b/engine/src/flutter/shell/platform/windows/flutter_windows_view.h
@@ -520,11 +520,12 @@ class FlutterWindowsView : public WindowBindingHandlerDelegate {
   std::shared_ptr<std::atomic<bool>> alive_token_ =
       std::make_shared<std::atomic<bool>>(true);
 
-  // Re-drives a pending resize: resends the target window metrics and
-  // schedules a frame so the framework produces a frame at the resize
-  // target size. Called on the platform thread. After
-  // |kMaxResizeRetries| attempts the resize is force-completed on the
-  // raster thread so the view can never wedge permanently.
+  // Re-drives a pending resize: retargets it to the window's current size,
+  // resends that size's metrics and schedules a frame so the framework
+  // produces a frame at it. Does nothing while the window is minimized.
+  // Called on the platform thread. After |kMaxResizeRetries| attempts the
+  // resize is force-completed on the raster thread so the view can never
+  // wedge permanently.
   void DriveResizeRetry();
 
   // Posts a platform-thread task that calls |DriveResizeRetry|. Callers
